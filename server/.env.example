# Servidor HTTP
PORT=3001

# Segredo para assinatura dos tokens JWT (ADMIN)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Nome/identificação do banco SQLite
DB_PATH=./data/hamburgueria.db

# ============================================================
# INTEGRAÇÃO WHATSAPP
# O sistema usa uma camada de provedores (services/whatsapp.js).
# Provedores disponíveis:
#   wa.me ............ link direto (sem API, abre conversa no WhatsApp)
#   evolution ........ Evolution API (requer EVOLUTION_URL, EVOLUTION_INSTANCE, EVOLUTION_TOKEN)
#   zapi ............. Z-API (requer ZAPI_CLIENT_TOKEN, ZAPI_INSTANCE_ID)
#   twilio ........... Twilio WhatsApp API (requer TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM)
#
# Para usar um provedor, defina WHATSAPP_PROVIDER. O token/número também podem
# ser configurados no painel admin (Configurações), que tem prioridade quando
# preenchidos. NUNCA exponha estas variáveis no frontend.
# ============================================================
WHATSAPP_PROVIDER=wa.me

# Evolution API
# EVOLUTION_URL=http://localhost:8080
# EVOLUTION_INSTANCE=instance1
# EVOLUTION_TOKEN=

# Z-API
# ZAPI_CLIENT_TOKEN=
# ZAPI_INSTANCE_ID=

# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=whatsapp:+5511999999999
